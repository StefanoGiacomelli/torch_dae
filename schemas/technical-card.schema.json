        "pss_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pss Bytes"
        },
        "rss_after_model_load_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rss After Model Load Bytes"
        },
        "rss_after_resource_pass_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rss After Resource Pass Bytes"
        },
        "rss_before_model_load_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rss Before Model Load Bytes"
        },
        "rss_before_resource_pass_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rss Before Resource Pass Bytes"
        },
        "rss_sampled_peak_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rss Sampled Peak Bytes"
        },
        "rss_sampled_peak_is_sampled": {
          "default": true,
