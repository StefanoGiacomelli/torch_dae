{
  "$defs": {
    "AcceleratorMemoryEvidence": {
      "additionalProperties": false,
      "description": "Device-native accelerator memory evidence (CUDA allocator or MPS surfaces).",
      "properties": {
        "backend": {
          "$ref": "#/$defs/DeviceBackend"
        },
        "cuda_current_allocated_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Current Allocated Bytes"
        },
        "cuda_current_reserved_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Current Reserved Bytes"
        },
        "cuda_peak_allocated_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Peak Allocated Bytes"
        },
        "cuda_peak_reserved_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Peak Reserved Bytes"
        },
        "mps_current_allocated_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mps Current Allocated Bytes"
        },
        "mps_driver_allocated_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mps Driver Allocated Bytes"
        },
        "unified_memory_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unified Memory Note"
        }
      },
      "required": [
        "backend"
      ],
      "title": "AcceleratorMemoryEvidence",
      "type": "object"
    },
    "ArchitectureEvidence": {
      "additionalProperties": false,
      "description": "Mandatory + optional architecture profiling evidence (Section 18).",
      "properties": {
        "buffer_bytes": {
          "title": "Buffer Bytes",
          "type": "integer"
        },
        "counting_backend": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counting Backend"
        },
        "counting_backend_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counting Backend Version"
        },
        "counting_convention": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counting Convention"
        },
        "dtype_distribution": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Dtype Distribution",
          "type": "object"
        },
        "flops": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flops"
        },
        "flops_macs_status": {
          "$ref": "#/$defs/ArchitectureEvidenceStatus",
          "default": "unavailable"
        },
        "macs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macs"
        },
        "module_count": {
          "title": "Module Count",
          "type": "integer"
        },
        "non_trainable_parameters": {
          "title": "Non Trainable Parameters",
          "type": "integer"
        },
        "parameter_bytes": {
          "title": "Parameter Bytes",
          "type": "integer"
        },
        "state_dict_tensor_bytes": {
          "title": "State Dict Tensor Bytes",
          "type": "integer"
        },
        "total_parameters": {
          "title": "Total Parameters",
          "type": "integer"
        },
        "trainable_parameters": {
          "title": "Trainable Parameters",
          "type": "integer"
        },
        "unaccounted_operations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unaccounted Operations",
          "type": "array"
        }
      },
      "required": [
        "total_parameters",
        "trainable_parameters",
        "non_trainable_parameters",
        "parameter_bytes",
        "buffer_bytes",
        "state_dict_tensor_bytes",
        "dtype_distribution",
        "module_count"
      ],
      "title": "ArchitectureEvidence",
      "type": "object"
    },
    "ArchitectureEvidenceStatus": {
      "description": "Coverage status for architecture/FLOPs evidence (Section 18).",
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ],
      "minLength": 1,
      "title": "ArchitectureEvidenceStatus",
      "type": "string"
    },
    "ColdStartEvidence": {
      "additionalProperties": false,
      "description": "Cold initialization/loading evidence, kept separate from steady-state timing.",
      "properties": {
        "checkpoint_loading_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Loading Ns"
        },
        "device_placement_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Placement Ns"
        },
        "first_inference_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Inference Ns"
        },
        "initialization_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initialization Ns"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "title": "ColdStartEvidence",
      "type": "object"
    },
    "ComparabilityMetadata": {
      "additionalProperties": false,
      "description": "Explicit metadata for future cross-card comparability analytics.",
      "properties": {
        "comparable_only_within_same_execution_context": {
          "default": true,
          "title": "Comparable Only Within Same Execution Context",
          "type": "boolean"
        },
        "execution_context_fingerprint": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Context Fingerprint",
          "type": "string"
        },
        "protocol_id": {
          "const": "audio-inference-v1",
          "minLength": 1,
          "title": "Protocol Id",
          "type": "string"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "runtime_classification": {
          "$ref": "#/$defs/RuntimeClassification"
        }
      },
      "required": [
        "protocol_id",
        "protocol_version",
        "execution_context_fingerprint",
        "runtime_classification"
      ],
      "title": "ComparabilityMetadata",
      "type": "object"
    },
    "ConditionStatus": {
      "description": "Outcome of one benchmarked (device, thread-regime, duration, batch) condition.",
      "enum": [
        "success",
        "unsupported",
        "not_tested"
      ],
      "minLength": 1,
      "title": "ConditionStatus",
      "type": "string"
    },
    "ContributorMetadata": {
      "additionalProperties": false,
      "description": "Optional contributor identity; never participates in technical validity.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "github_handle": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Handle"
        }
      },
      "title": "ContributorMetadata",
      "type": "object"
    },
    "DeviceBackend": {
      "description": "Supported device/backend selectors.",
      "enum": [
        "cpu",
        "mps",
        "cuda"
      ],
      "minLength": 1,
      "title": "DeviceBackend",
      "type": "string"
    },
    "DeviceBackendMetadata": {
      "additionalProperties": false,
      "description": "Concrete device/backend identity for one Technical Card.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/DeviceBackend"
        },
        "device_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Index"
        },
        "device_label": {
          "minLength": 1,
          "title": "Device Label",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "device_label"
      ],
      "title": "DeviceBackendMetadata",
      "type": "object"
    },
    "EnergyEvidence": {
      "additionalProperties": false,
      "description": "CodeCarbon-backed energy evidence for the separate resource pass (Section 23).\n\n``total_energy_kwh`` (when present) is only ever the sum of the components this evidence\nactually measured or estimated; it is never a claim of complete run/system energy. Whether it\nrepresents the *whole* active run is stated explicitly by ``coverage_complete`` and\n``unaccounted_components`` -- e.g. an MPS run whose CPU/RAM energy is software-estimated but\nwhose accelerator energy CodeCarbon cannot measure MUST set\n``coverage_complete=False`` and ``unaccounted_components=(\"accelerator\",)`` rather than\nsilently presenting a CPU+RAM-only total as if it were the full run's energy.",
      "properties": {
        "accelerator_energy_kwh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accelerator Energy Kwh"
        },
        "average_power_watts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Power Watts"
        },
        "codecarbon_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codecarbon Version"
        },
        "coverage_complete": {
          "default": false,
          "title": "Coverage Complete",
          "type": "boolean"
        },
        "cpu_energy_kwh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Energy Kwh"
        },
        "failure_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "measurement_duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Duration Seconds"
        },
        "measurement_interval_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Interval Seconds"
        },
        "measurement_kind": {
          "$ref": "#/$defs/EnergyMeasurementKind"
        },
        "measurement_scope": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Scope"
        },
        "privilege_used": {
          "default": false,
          "title": "Privilege Used",
          "type": "boolean"
        },
        "ram_energy_kwh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Energy Kwh"
        },
        "total_energy_kwh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Energy Kwh"
        },
        "unaccounted_components": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unaccounted Components",
          "type": "array"
        }
      },
      "required": [
        "measurement_kind"
      ],
      "title": "EnergyEvidence",
      "type": "object"
    },
    "EnergyMeasurementKind": {
      "description": "CodeCarbon measurement classification (Section 23).",
      "enum": [
        "hardware_measured",
        "software_estimated",
        "unavailable",
        "failed"
      ],
      "minLength": 1,
      "title": "EnergyMeasurementKind",
      "type": "string"
    },
    "ExecutionContextMetadata": {
      "additionalProperties": false,
      "description": "Privacy-safe fingerprint binding reproducibility-relevant execution conditions.",
      "properties": {
        "device_backend": {
          "$ref": "#/$defs/DeviceBackend"
        },
        "execution_context_fingerprint": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Context Fingerprint",
          "type": "string"
        },
        "hardware_fingerprint": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hardware Fingerprint",
          "type": "string"
        },
        "native_precision": {
          "minLength": 1,
          "title": "Native Precision",
          "type": "string"
        },
        "os_name": {
          "minLength": 1,
          "title": "Os Name",
          "type": "string"
        },
        "os_version": {
          "minLength": 1,
          "title": "Os Version",
          "type": "string"
        },
        "profiler_implementation_version": {
          "minLength": 1,
          "title": "Profiler Implementation Version",
          "type": "string"
        },
        "profiling_protocol_id": {
          "const": "audio-inference-v1",
          "minLength": 1,
          "title": "Profiling Protocol Id",
          "type": "string"
        },
        "profiling_protocol_version": {
          "minLength": 1,
          "title": "Profiling Protocol Version",
          "type": "string"
        },
        "python_version": {
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "thread_regime": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadRegime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "torch_dae_content_identity": {
          "minLength": 1,
          "title": "Torch Dae Content Identity",
          "type": "string"
        },
        "torch_version": {
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        }
      },
      "required": [
        "hardware_fingerprint",
        "execution_context_fingerprint",
        "os_name",
        "os_version",
        "python_version",
        "torch_version",
        "torch_dae_content_identity",
        "device_backend",
        "native_precision",
        "profiling_protocol_id",
        "profiling_protocol_version",
        "profiler_implementation_version"
      ],
      "title": "ExecutionContextMetadata",
      "type": "object"
    },
    "HardwareMetadata": {
      "additionalProperties": false,
      "description": "Privacy-safe hardware-configuration evidence (never a physical-machine identifier).",
      "properties": {
        "accelerator_memory_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accelerator Memory Bytes"
        },
        "accelerator_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accelerator Model"
        },
        "accelerator_vendor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accelerator Vendor"
        },
        "backend_capabilities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Backend Capabilities",
          "type": "array"
        },
        "cpu_architecture": {
          "minLength": 1,
          "title": "Cpu Architecture",
          "type": "string"
        },
        "cpu_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Model"
        },
        "logical_cores": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Cores"
        },
        "physical_cores": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Cores"
        },
        "total_ram_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Ram Bytes"
        }
      },
      "required": [
        "cpu_architecture"
      ],
      "title": "HardwareMetadata",
      "type": "object"
    },
    "HostMemoryEvidence": {
      "additionalProperties": false,
      "description": "Host RAM / process RSS evidence (Section 19).",
