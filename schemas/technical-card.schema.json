        }
      },
      "title": "HostMemoryEvidence",
      "type": "object"
    },
    "MeasurementCoverage": {
      "additionalProperties": false,
      "description": "Explicit tested/untested/unsupported coverage summary distinguishing absence types.",
      "properties": {
        "accelerator_memory_available": {
          "title": "Accelerator Memory Available",
          "type": "boolean"
        },
        "architecture_status": {
          "$ref": "#/$defs/ArchitectureEvidenceStatus"
        },
        "energy_status": {
          "$ref": "#/$defs/EnergyMeasurementKind"
        },
        "host_memory_available": {
          "title": "Host Memory Available",
          "type": "boolean"
        },
        "not_tested_conditions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Not Tested Conditions",
          "type": "array"
        },
        "tested_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tested Conditions",
          "type": "array"
        },
        "unsupported_conditions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unsupported Conditions",
          "type": "array"
        }
      },
      "required": [
        "tested_conditions",
        "architecture_status",
        "energy_status",
        "host_memory_available",
        "accelerator_memory_available"
      ],
      "title": "MeasurementCoverage",
      "type": "object"
    },
    "MinimumInputProbeRecord": {
      "additionalProperties": false,
      "description": "One ordered probe observation in the minimum-input search (Section 11).\n\nPersisted so the search can be audited after the fact: which sample counts were tried, in\nwhat order, and whether each one succeeded.",
      "properties": {
        "probe_order": {
          "title": "Probe Order",
          "type": "integer"
        },
        "sample_count": {
          "title": "Sample Count",
          "type": "integer"
        },
        "succeeded": {
          "title": "Succeeded",
          "type": "boolean"
        }
      },
      "required": [
        "probe_order",
        "sample_count",
        "succeeded"
      ],
      "title": "MinimumInputProbeRecord",
      "type": "object"
    },
    "MinimumInputSearchResult": {
      "additionalProperties": false,
      "description": "Empirical minimum supported input search evidence (Section 11).",
      "properties": {
        "below_boundary_verified": {
          "default": false,
          "title": "Below Boundary Verified",
          "type": "boolean"
        },
        "boundary_verified": {
          "default": false,
          "title": "Boundary Verified",
          "type": "boolean"
        },
        "minimum_duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Duration Seconds"
        },
        "minimum_sample_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Sample Count"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "probe_records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MinimumInputProbeRecord"
          },
          "title": "Probe Records",
          "type": "array"
        },
        "probe_sample_counts_tested": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Probe Sample Counts Tested",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MinimumInputStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "MinimumInputSearchResult",
      "type": "object"
    },
    "MinimumInputStatus": {
      "description": "Outcome of the empirical minimum-input search (Section 11).",
      "enum": [
        "found",
        "non_monotonic",
        "always_unsupported",
        "max_duration_exhausted"
      ],
      "minLength": 1,
      "title": "MinimumInputStatus",
      "type": "string"
    },
    "ModelReference": {
      "additionalProperties": false,
      "description": "Immutable reference to the accepted Model Card and checkpoint being profiled.",
      "properties": {
        "checkpoint_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "checkpoint_sha256": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "model_card_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Model Card Id",
          "type": "string"
        },
        "model_card_path": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "title": "Model Card Path",
          "type": "string"
        },
        "model_card_sha256": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Card Sha256",
          "type": "string"
        },
        "model_card_status": {
          "minLength": 1,
          "title": "Model Card Status",
          "type": "string"
        },
        "wrapper_entry_point": {
          "minLength": 1,
          "title": "Wrapper Entry Point",
          "type": "string"
        }
      },
      "required": [
        "model_card_id",
        "model_card_path",
        "model_card_sha256",
        "model_card_status",
        "checkpoint_id",
        "checkpoint_sha256",
        "wrapper_entry_point"
      ],
      "title": "ModelReference",
      "type": "object"
    },
    "PrecisionMetadata": {
      "additionalProperties": false,
      "description": "Native execution precision (only verified/native precision is benchmarked in v1).",
      "properties": {
        "autocast": {
          "default": false,
          "title": "Autocast",
          "type": "boolean"
        },
        "dtype": {
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        }
      },
      "required": [
        "dtype"
      ],
      "title": "PrecisionMetadata",
      "type": "object"
    },
    "ProfilerImplementationProvenance": {
      "additionalProperties": false,
      "description": "Identity of the profiling tooling that produced this evidence, distinct from the model.",
      "properties": {
        "codecarbon_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codecarbon Version"
        },
        "profiler_implementation_version": {
          "minLength": 1,
          "title": "Profiler Implementation Version",
          "type": "string"
        },
        "profiling_protocol_id": {
          "const": "audio-inference-v1",
          "minLength": 1,
          "title": "Profiling Protocol Id",
          "type": "string"
        },
        "profiling_protocol_version": {
          "minLength": 1,
          "title": "Profiling Protocol Version",
          "type": "string"
        },
        "psutil_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Psutil Version"
        },
        "runtime_classification": {
          "$ref": "#/$defs/RuntimeClassification"
        },
        "torch_dae_content_identity": {
          "minLength": 1,
          "title": "Torch Dae Content Identity",
          "type": "string"
        },
        "torch_dae_package_version": {
          "minLength": 1,
          "title": "Torch Dae Package Version",
          "type": "string"
        },
        "torch_dae_repository_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Torch Dae Repository Dirty"
        },
        "torch_dae_repository_head": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Torch Dae Repository Head"
        }
      },
      "required": [
        "profiler_implementation_version",
        "profiling_protocol_id",
        "profiling_protocol_version",
        "torch_dae_package_version",
        "torch_dae_content_identity",
        "torch_dae_repository_head",
        "torch_dae_repository_dirty",
        "runtime_classification"
      ],
      "title": "ProfilerImplementationProvenance",
      "type": "object"
    },
    "ProfilingCampaignReference": {
      "additionalProperties": false,
      "description": "Reference back to the orchestrating campaign that produced this card.",
      "properties": {
        "campaign_id": {
          "minLength": 1,
          "title": "Campaign Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "campaign_id",
        "run_id"
      ],
      "title": "ProfilingCampaignReference",
      "type": "object"
    },
    "ProfilingConditions": {
      "additionalProperties": false,
      "description": "One benchmarked (duration, batch) condition and its outcome.",
      "properties": {
        "batch_size": {
          "title": "Batch Size",
          "type": "integer"
        },
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "duration_source": {
          "enum": [
            "canonical_contract",
            "protocol_default",
            "empirical_minimum"
          ],
          "minLength": 1,
          "title": "Duration Source",
          "type": "string"
        },
        "raw_timing_array": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Timing Array"
        },
        "sample_count": {
          "title": "Sample Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ConditionStatus"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimingSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        }
      },
      "required": [
        "condition_id",
        "duration_seconds",
        "duration_source",
        "batch_size",
        "sample_count",
        "status"
      ],
      "title": "ProfilingConditions",
      "type": "object"
    },
    "RawArrayDescriptor": {
      "additionalProperties": false,
      "description": "One named array inside the raw `.npz` measurement manifest (Section 26).",
      "properties": {
        "dtype": {
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "name",
        "dtype",
        "shape"
      ],
      "title": "RawArrayDescriptor",
      "type": "object"
    },
    "RawMeasurementManifest": {
      "additionalProperties": false,
      "description": "Reference and manifest for the bounded lossless raw `.npz` asset.\n\n``path`` is relative to the Technical Card JSON's own directory, never to the repository\nroot, so a reviewed JSON+`.npz` pair validates identically before and after being relocated\ntogether (e.g. candidate workspace -> `technical_cards/<model-id>/`). Absolute paths and any\n`..` traversal or directory-escape are rejected.",
      "properties": {
        "arrays": {
          "items": {
            "$ref": "#/$defs/RawArrayDescriptor"
          },
          "title": "Arrays",
          "type": "array"
        },
        "media_type": {
          "const": "application/x-npz",
          "default": "application/x-npz",
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "arrays"
      ],
      "title": "RawMeasurementManifest",
      "type": "object"
    },
    "RuntimeClassification": {
      "description": "Whether a profiling run used unmodified, modified, or unknown torch-dae source.",
      "enum": [
        "canonical",
        "modified_runtime",
        "unknown_runtime"
      ],
      "minLength": 1,
      "title": "RuntimeClassification",
      "type": "string"
    },
    "SoftwareMetadata": {
      "additionalProperties": false,
      "description": "Software stack evidence relevant to reproducibility.",
      "properties": {
        "cuda_driver_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Driver Version"
        },
        "cuda_runtime_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Runtime Version"
        },
        "cudnn_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cudnn Version"
        },
        "mps_backend_info": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mps Backend Info"
        },
        "os_name": {
          "minLength": 1,
          "title": "Os Name",
          "type": "string"
        },
        "os_version": {
          "minLength": 1,
          "title": "Os Version",
          "type": "string"
        },
        "python_implementation": {
          "minLength": 1,
          "title": "Python Implementation",
          "type": "string"
        },
        "python_version": {
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "torch_version": {
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        }
      },
      "required": [
        "os_name",
        "os_version",
        "python_implementation",
        "python_version",
        "torch_version"
      ],
      "title": "SoftwareMetadata",
      "type": "object"
    },
    "SupersessionMetadata": {
      "additionalProperties": false,
      "description": "Optional supersession pointer for a corrected later Technical Card.",
      "properties": {
        "supersede_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersede Reason"
        },
        "supersedes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "title": "SupersessionMetadata",
      "type": "object"
    },
    "SyntheticInputProvenance": {
      "additionalProperties": false,
      "description": "Deterministic synthetic white-noise input provenance (Section 9).",
      "properties": {
        "batch_size": {
          "title": "Batch Size",
          "type": "integer"
        },
        "channel_count": {
          "title": "Channel Count",
          "type": "integer"
        },
        "distribution": {
          "const": "uniform",
          "default": "uniform",
          "minLength": 1,
          "title": "Distribution",
          "type": "string"
        },
        "dtype": {
          "const": "float32",
          "default": "float32",
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        },
        "high": {
          "default": 1.0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "default": -1.0,
          "title": "Low",
          "type": "number"
        },
        "prng_implementation": {
          "minLength": 1,
          "title": "Prng Implementation",
          "type": "string"
        },
        "sample_count": {
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_rate": {
          "title": "Sample Rate",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "tensor_sha256": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tensor Sha256"
        }
      },
      "required": [
        "prng_implementation",
        "seed",
        "sample_rate",
        "sample_count",
        "batch_size",
        "channel_count"
      ],
      "title": "SyntheticInputProvenance",
      "type": "object"
    },
    "TechnicalCardIdentity": {
      "additionalProperties": false,
      "description": "Technical Card identity: a hash digest plus its stable human-facing form.",
      "properties": {
        "identity_digest_sha256": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Digest Sha256",
          "type": "string"
        },
        "nonce": {
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "technical_card_id": {
          "minLength": 1,
          "title": "Technical Card Id",
          "type": "string"
        }
      },
      "required": [
        "technical_card_id",
        "identity_digest_sha256",
        "nonce"
      ],
      "title": "TechnicalCardIdentity",
      "type": "object"
    },
    "ThreadRegime": {
      "description": "CPU intra-op thread regime.",
      "enum": [
        "single_thread",
        "native_default"
      ],
      "minLength": 1,
      "title": "ThreadRegime",
      "type": "string"
    },
    "TimingSummary": {
      "additionalProperties": false,
      "description": "Recomputable summary statistics over 50 raw steady-state latency observations.",
      "properties": {
        "coefficient_of_variation": {
          "title": "Coefficient Of Variation",
          "type": "number"
        },
        "forward_calls_per_second": {
          "title": "Forward Calls Per Second",
          "type": "number"
        },
        "max_ns": {
          "title": "Max Ns",
          "type": "integer"
        },
        "mean_ns": {
          "title": "Mean Ns",
          "type": "number"
        },
        "min_ns": {
          "title": "Min Ns",
          "type": "integer"
        },
        "p50_ns": {
          "title": "P50 Ns",
          "type": "number"
        },
        "p90_ns": {
          "title": "P90 Ns",
          "type": "number"
        },
        "p95_ns": {
          "title": "P95 Ns",
          "type": "number"
        },
        "p99_ns": {
          "title": "P99 Ns",
          "type": "number"
        },
        "real_time_factor": {
          "title": "Real Time Factor",
          "type": "number"
        },
        "sample_count": {
          "const": 50,
          "title": "Sample Count",
          "type": "integer"
        },
        "speed_factor": {
          "title": "Speed Factor",
          "type": "number"
        },
        "stddev_ns": {
          "title": "Stddev Ns",
          "type": "number"
        },
        "throughput_items_per_second": {
          "title": "Throughput Items Per Second",
          "type": "number"
        }
      },
      "required": [
        "sample_count",
        "mean_ns",
        "stddev_ns",
        "min_ns",
        "max_ns",
        "p50_ns",
        "p90_ns",
        "p95_ns",
        "p99_ns",
        "coefficient_of_variation",
        "throughput_items_per_second",
        "forward_calls_per_second",
        "real_time_factor",
        "speed_factor"
      ],
      "title": "TimingSummary",
      "type": "object"
    }
  },
  "$id": "https://torch-dae.local/schemas/technical-card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete immutable Technical Card: one Model Card, one protocol, one device, one session.",
  "properties": {
    "accelerator_memory": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceleratorMemoryEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "architecture": {
      "$ref": "#/$defs/ArchitectureEvidence"
    },
    "campaign": {
      "$ref": "#/$defs/ProfilingCampaignReference"
    },
    "canonical_duration_seconds": {
      "title": "Canonical Duration Seconds",
      "type": "number"
    },
    "canonical_duration_source": {
      "enum": [
        "explicit_model_contract",
        "protocol_default"
      ],
      "minLength": 1,
      "title": "Canonical Duration Source",
      "type": "string"
    },
    "cold_start": {
      "$ref": "#/$defs/ColdStartEvidence"
    },
    "comparability": {
      "$ref": "#/$defs/ComparabilityMetadata"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/ProfilingConditions"
      },
      "title": "Conditions",
      "type": "array"
    },
    "contributor": {
      "$ref": "#/$defs/ContributorMetadata",
      "default": {
        "display_name": null,
        "github_handle": null
      }
    },
    "coverage": {
      "$ref": "#/$defs/MeasurementCoverage"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "device": {
      "$ref": "#/$defs/DeviceBackendMetadata"
    },
    "energy": {
      "$ref": "#/$defs/EnergyEvidence"
    },
    "execution_context": {
      "$ref": "#/$defs/ExecutionContextMetadata"
    },
    "hardware": {
      "$ref": "#/$defs/HardwareMetadata"
    },
    "host_memory": {
      "$ref": "#/$defs/HostMemoryEvidence"
    },
    "identity": {
      "$ref": "#/$defs/TechnicalCardIdentity"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "minimum_input_search": {
      "$ref": "#/$defs/MinimumInputSearchResult"
    },
    "model": {
      "$ref": "#/$defs/ModelReference"
    },
    "precision": {
      "$ref": "#/$defs/PrecisionMetadata"
    },
    "profiler": {
      "$ref": "#/$defs/ProfilerImplementationProvenance"
    },
    "raw_measurements": {
      "$ref": "#/$defs/RawMeasurementManifest"
    },
    "software": {
      "$ref": "#/$defs/SoftwareMetadata"
    },
    "supersession": {
      "$ref": "#/$defs/SupersessionMetadata",
      "default": {
        "supersede_reason": null,
        "supersedes": null
      }
    },
    "synthetic_input": {
      "$ref": "#/$defs/SyntheticInputProvenance"
    },
    "technical_card_schema_version": {
      "const": "1.0.0",
      "minLength": 1,
      "title": "Technical Card Schema Version",
      "type": "string"
    }
  },
  "required": [
    "technical_card_schema_version",
    "identity",
    "model",
    "profiler",
    "hardware",
    "software",
    "device",
    "execution_context",
    "precision",
    "synthetic_input",
    "canonical_duration_seconds",
    "canonical_duration_source",
    "architecture",
    "cold_start",
    "minimum_input_search",
    "conditions",
    "host_memory",
    "energy",
    "raw_measurements",
    "coverage",
    "comparability",
    "campaign",
    "created_at"
  ],
  "title": "TechnicalCard",
  "type": "object"
}
