{
  "$defs": {
    "TensorDimension": {
      "additionalProperties": false,
      "description": "Structured tensor dimension observation.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dynamic": {
          "default": false,
          "title": "Dynamic",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "required": [
        "name"
      ],
      "title": "TensorDimension",
      "type": "object"
    },
    "TensorObservation": {
      "additionalProperties": false,
      "description": "Structured tensor observation from runtime verification.",
      "properties": {
        "component_path": {
          "minLength": 1,
          "title": "Component Path",
          "type": "string"
        },
        "device": {
          "minLength": 1,
          "title": "Device",
          "type": "string"
        },
        "dtype": {
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        },
        "lengths": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lengths"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rank": {
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "shape": {
          "items": {
            "$ref": "#/$defs/TensorDimension"
          },
          "title": "Shape",
          "type": "array"
        },
        "temporal_metadata": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Metadata"
        }
      },
      "required": [
        "name",
        "role",
        "component_path",
        "shape",
        "rank",
        "dtype",
        "device"
      ],
      "title": "TensorObservation",
      "type": "object"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "description": "Single runtime verification check.",
      "properties": {
        "details": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unsupported"
          ],
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "VerificationCheck",
      "type": "object"
    }
  },
  "$id": "https://torch-dae.local/schemas/verification-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "optional_check_ids": {
            "maxItems": 0
          },
          "required_check_ids": {
            "maxItems": 0
          },
          "verification_status": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint_id": {
            "type": "string"
          },
          "checks": {
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "environment_spec_sha256": {
            "type": "string"
          },
          "integrated_variant_id": {
            "type": "string"
          },
          "integration_handoff_sha256": {
            "type": "string"
          },
          "optional_check_ids": {
            "type": "array",
            "uniqueItems": true
          },
          "public_model_entry_point": {
            "type": "string"
          },
          "required_check_ids": {
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "runtime_target_id": {
            "type": "string"
          },
          "source_manifest_sha256": {
            "type": "string"
          },
          "verification_status": {
            "type": "string"
          },
          "workflow_id": {
            "type": "string"
          }
        },
        "required": [
          "runtime_target_id",
          "workflow_id",
          "integrated_variant_id",
          "checkpoint_id",
          "public_model_entry_point",
          "integration_handoff_sha256",
          "environment_spec_sha256",
          "source_manifest_sha256",
          "required_check_ids",
          "optional_check_ids",
          "verification_status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "passed"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                },
                "required": [
                  "status"
                ],
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "failed"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              },
              "required": [
                "status"
              ],
              "type": "object"
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "description": "Runtime verification report contract.",
  "properties": {
    "checkpoint_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Id"
    },
    "checkpoint_sha256": {
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checkpoint Sha256",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "device": {
      "minLength": 1,
      "title": "Device",
      "type": "string"
    },
    "embedding_results": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Embedding Results",
      "type": "array"
    },
    "environment_fingerprint": {
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Fingerprint",
      "type": "string"
    },
    "environment_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Environment Id",
      "type": "string"
    },
    "environment_spec_sha256": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Spec Sha256"
    },
    "input_contracts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Input Contracts",
      "type": "array"
    },
    "integrated_variant_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Integrated Variant Id"
    },
    "integration_handoff_sha256": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Integration Handoff Sha256"
    },
    "known_limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Known Limitations",
      "type": "array"
    },
    "model_card_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Model Card Id",
      "type": "string"
    },
    "optional_check_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Optional Check Ids",
      "type": "array"
    },
    "passed_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Passed Capabilities",
      "type": "array"
    },
    "platform": {
      "minLength": 1,
      "title": "Platform",
      "type": "string"
    },
    "public_model_entry_point": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Model Entry Point"
    },
    "report_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Report Id",
      "type": "string"
    },
    "required_check_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Required Check Ids",
      "type": "array"
    },
    "runtime_target_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Target Id"
    },
    "schema_version": {
      "enum": [
        "1.0.0",
        "2.0.0"
      ],
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_sha256": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Manifest Sha256"
    },
    "tensor_observations": {
      "items": {
        "$ref": "#/$defs/TensorObservation"
      },
      "title": "Tensor Observations",
      "type": "array"
    },
    "unsupported_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unsupported Capabilities",
      "type": "array"
    },
    "verification_status": {
      "anyOf": [
        {
          "enum": [
            "passed",
            "failed"
          ],
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Status"
    },
    "workflow_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Id"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "model_card_id",
    "environment_id",
    "environment_fingerprint",
    "created_at",
    "platform",
    "device",
    "checkpoint_sha256",
    "input_contracts",
    "tensor_observations",
    "embedding_results",
    "passed_capabilities",
    "unsupported_capabilities",
    "known_limitations",
    "checks"
  ],
  "title": "VerificationReport",
  "type": "object"
}
