          "default": null,
          "title": "Task Head Relation"
        }
      },
      "required": [
        "name",
        "kind",
        "semantic_kind",
        "rank",
        "layout",
        "dimensions"
      ],
      "title": "OutputComponent",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "description": "Forward and probability output declarations.",
      "properties": {
        "components": {
          "items": {
