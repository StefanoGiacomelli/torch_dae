      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/SourceRecord"
        },
        "implementation": {
          "$ref": "#/$defs/SourceRecord"
        },
        "official_repository": {
          "$ref": "#/$defs/SourceRecord"
        },
        "wrapper": {
          "$ref": "#/$defs/SourceRecord"
        }
      },
      "required": [
        "official_repository",
        "implementation",
        "checkpoint",
        "wrapper"
      ],
      "title": "Sources",
      "type": "object"
    },
    "Tasks": {
      "additionalProperties": false,
      "description": "Task roles separated by phase.",
      "properties": {
        "finetuning": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Finetuning",
          "type": "array"
        },
        "official_evaluation": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Official Evaluation",
          "type": "array"
        },
        "pretraining": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Pretraining",
