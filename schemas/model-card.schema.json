        "specification": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "title": "Specification",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "environment_id",
        "specification",
        "lockfile",
        "verified"
      ],
      "title": "RecommendedEnvironment",
      "type": "object"
    },
    "ScientificReference": {
      "additionalProperties": false,
      "description": "Publication metadata.",
      "properties": {
        "authors": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "doi": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "official_publication": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Publication"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "title",
        "authors"
      ],
      "title": "ScientificReference",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "Repository, package, or asset source evidence.",
      "properties": {
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "revision": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "kind",
        "evidence_status"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "Sources": {
