          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Supported Inference",
          "type": "array"
        }
      },
      "required": [
        "pretraining",
        "finetuning",
        "official_evaluation",
        "supported_inference"
      ],
      "title": "Tasks",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Usage references and commands.",
      "properties": {
        "checkpoint_loading": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Checkpoint Loading",
          "type": "array"
        },
        "installation_commands": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Installation Commands",
