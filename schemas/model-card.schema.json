      ],
      "title": "Usage",
      "type": "object"
    },
    "WaveformInput": {
      "additionalProperties": false,
      "description": "Canonical public waveform input contract.",
      "properties": {
        "channels": {
          "minLength": 1,
          "title": "Channels",
          "type": "string"
        },
        "dtype": {
          "default": "float32",
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        },
        "normalization": {
          "minLength": 1,
          "title": "Normalization",
          "type": "string"
        },
        "padding": {
          "minLength": 1,
          "title": "Padding",
          "type": "string"
        },
        "resampling": {
          "minLength": 1,
          "title": "Resampling",
          "type": "string"
        },
        "sample_rate_hz": {
          "exclusiveMinimum": 0,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
