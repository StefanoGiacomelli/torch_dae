          "const": "B,C,T",
          "minLength": 1,
          "title": "Shape",
          "type": "string"
        },
        "valid_lengths_shape": {
          "anyOf": [
            {
              "const": "B",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "B",
          "title": "Valid Lengths Shape"
        }
      },
      "required": [
        "shape",
        "sample_rate_hz",
        "channels",
        "resampling",
        "padding",
        "normalization"
      ],
      "title": "WaveformInput",
      "type": "object"
    }
  },
  "$id": "https://torch-dae.local/schemas/model-card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "card_status": {
            "enum": [
              "environment_resolved",
              "checkpoint_verified",
              "runtime_verified",
              "profiled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "usage": {
            "properties": {
              "recommended_environment": {
                "properties": {
                  "verified": {
                    "const": true
                  }
                },
                "required": [
                  "verified"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "card_status": {
            "enum": [
              "checkpoint_verified",
              "runtime_verified",
              "profiled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint": {
            "properties": {
              "observed_sha256": {
                "type": "string"
              }
            },
            "required": [
              "observed_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "card_status": {
            "enum": [
              "runtime_verified",
              "profiled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "verification_report": {
            "type": "string"
          }
        },
        "required": [
          "verification_report"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "card_status": {
            "const": "profiled"
          }
        }
      },
      "then": {
        "properties": {
          "architectural_profiling": {
            "properties": {
              "status": {
                "const": "profiled"
              }
            }
          },
          "energy_profiling": {
            "properties": {
              "status": {
                "const": "profiled"
              }
            }
          },
          "inference_profiling": {
            "properties": {
              "status": {
                "const": "profiled"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "probabilities": {
                "properties": {
                  "supported": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "probability_output": {
                "$ref": "#/$defs/OutputComponent"
              }
            },
            "required": [
              "probability_output"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "probabilities": {
                "properties": {
                  "supported": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "probability_output": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "embeddings": {
                "properties": {
                  "supported": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "embeddings": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "description": "Complete checkpoint-specific model card contract.",
  "properties": {
    "architectural_profiling": {
      "$ref": "#/$defs/ProfilingSection"
    },
    "capabilities": {
      "$ref": "#/$defs/CapabilitiesSection"
    },
    "card_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Card Id",
      "type": "string"
    },
    "card_status": {
      "$ref": "#/$defs/ModelCardLifecycle"
    },
    "checkpoint": {
      "$ref": "#/$defs/CheckpointSpec"
    },
    "datasets": {
      "$ref": "#/$defs/Datasets"
    },
    "description": {
      "$ref": "#/$defs/Description"
    },
    "device_support": {
      "$ref": "#/$defs/DeviceSupport"
    },
    "embeddings": {
      "$ref": "#/$defs/EmbeddingsSection"
    },
    "energy_profiling": {
      "$ref": "#/$defs/ProfilingSection"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "identity": {
      "$ref": "#/$defs/Identity"
    },
    "inference_profiling": {
      "$ref": "#/$defs/ProfilingSection"
    },
    "input": {
      "$ref": "#/$defs/WaveformInput"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/IssueRecord"
      },
      "title": "Issues",
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    },
    "reported_metrics": {
      "items": {
        "$ref": "#/$defs/MetricRecord"
      },
      "title": "Reported Metrics",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_reference": {
      "$ref": "#/$defs/ScientificReference"
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    },
    "tasks": {
      "$ref": "#/$defs/Tasks"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "verification_report": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Report"
    }
  },
  "required": [
    "schema_version",
    "card_id",
    "card_status",
    "identity",
    "checkpoint",
    "sources",
    "scientific_reference",
    "description",
    "tasks",
    "datasets",
    "reported_metrics",
    "usage",
    "input",
    "outputs",
    "embeddings",
    "capabilities",
    "device_support",
    "architectural_profiling",
    "inference_profiling",
    "energy_profiling",
    "limitations",
    "issues",
    "evidence"
  ],
  "title": "ModelCard",
  "type": "object"
}
