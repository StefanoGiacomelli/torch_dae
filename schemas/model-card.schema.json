              "type": "null"
            }
          ],
          "default": null,
          "title": "Report"
        },
        "status": {
          "$ref": "#/$defs/ProfilingStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "ProfilingSection",
      "type": "object"
    },
    "ProfilingStatus": {
      "description": "Profiling status reserved for later phases.",
      "enum": [
        "not_profiled",
        "profiled"
      ],
      "minLength": 1,
      "title": "ProfilingStatus",
      "type": "string"
    },
    "RecommendedEnvironment": {
      "additionalProperties": false,
      "description": "Reference to committed environment artifacts.",
      "properties": {
        "environment_id": {
