{
  "$defs": {
    "BooleanCapability": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "supported": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ],
      "description": "Capability support plus optional reason.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "supported"
      ],
      "title": "BooleanCapability",
      "type": "object"
    },
    "CapabilitiesSection": {
      "additionalProperties": false,
      "description": "Model-independent capability declarations.",
      "properties": {
        "checkpoint_loading": {
          "$ref": "#/$defs/BooleanCapability"
        },
        "embeddings": {
          "$ref": "#/$defs/BooleanCapability"
        },
        "probabilities": {
          "$ref": "#/$defs/BooleanCapability"
        },
        "random_initialization": {
          "$ref": "#/$defs/BooleanCapability"
        }
      },
      "required": [
        "random_initialization",
        "checkpoint_loading",
        "probabilities",
        "embeddings"
      ],
      "title": "CapabilitiesSection",
      "type": "object"
    },
    "CheckpointSourceType": {
      "description": "Supported checkpoint source variants.",
      "enum": [
        "https",
        "github_release",
        "huggingface",
        "package_bundle",
        "local_path"
      ],
      "minLength": 1,
      "title": "CheckpointSourceType",
      "type": "string"
    },
    "CheckpointSpec": {
      "additionalProperties": false,
      "description": "Checkpoint specification for one concrete pretrained asset.",
      "properties": {
        "checkpoint_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "filename": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/LicenseRecord"
        },
        "loader": {
          "minLength": 1,
          "title": "Loader",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "observed_sha256": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Sha256"
        },
        "package": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "package_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Version"
        },
        "release_tag": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Tag"
        },
        "repository_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Id"
        },
        "revision": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "schema_version": {
          "const": "1.0.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/CheckpointSourceType"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "schema_version",
        "checkpoint_id",
        "source_type",
        "format",
        "loader",
        "license"
      ],
      "title": "CheckpointSpec",
      "type": "object"
    },
    "DatasetRecord": {
      "additionalProperties": false,
      "description": "Dataset usage record.",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "source_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "split": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split"
        },
        "subset": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subset"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name",
        "role",
        "source_status"
      ],
      "title": "DatasetRecord",
      "type": "object"
    },
    "Datasets": {
      "additionalProperties": false,
      "description": "Training, validation, and testing dataset partitions.",
      "properties": {
        "testing": {
          "items": {
            "$ref": "#/$defs/DatasetRecord"
          },
          "title": "Testing",
          "type": "array"
        },
        "training": {
          "items": {
            "$ref": "#/$defs/DatasetRecord"
          },
          "title": "Training",
          "type": "array"
        },
        "validation": {
          "items": {
            "$ref": "#/$defs/DatasetRecord"
          },
          "title": "Validation",
          "type": "array"
        }
      },
      "required": [
        "training",
        "validation",
        "testing"
      ],
      "title": "Datasets",
      "type": "object"
    },
    "Description": {
      "additionalProperties": false,
      "description": "Separated descriptive claims.",
      "properties": {
        "architecture": {
          "minLength": 1,
          "title": "Architecture",
          "type": "string"
        },
        "checkpoint_behavior": {
          "minLength": 1,
          "title": "Checkpoint Behavior",
          "type": "string"
        },
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "preprocessing": {
          "minLength": 1,
          "title": "Preprocessing",
          "type": "string"
        },
        "training_objective": {
          "minLength": 1,
          "title": "Training Objective",
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "preprocessing",
        "training_objective",
        "checkpoint_behavior",
        "implementation"
      ],
      "title": "Description",
      "type": "object"
    },
    "DeviceSupport": {
      "additionalProperties": false,
      "description": "Declared and observed device support.",
      "properties": {
        "known_limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Known Limitations",
          "type": "array"
        },
        "locally_tested": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Locally Tested",
          "type": "array"
        },
        "upstream_declared": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Upstream Declared",
          "type": "array"
        }
      },
      "required": [
        "upstream_declared",
        "locally_tested",
        "known_limitations"
      ],
      "title": "DeviceSupport",
      "type": "object"
    },
    "EmbeddingSpec": {
      "additionalProperties": false,
      "description": "Model-independent embedding declaration.",
      "properties": {
        "default": {
          "title": "Default",
          "type": "boolean"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dimension": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "dtype": {
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        },
        "embedding_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Embedding Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "granularity": {
          "minLength": 1,
          "title": "Granularity",
          "type": "string"
        },
        "layout": {
          "minLength": 1,
          "title": "Layout",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "network_location": {
          "minLength": 1,
          "title": "Network Location",
          "type": "string"
        },
        "normalization": {
          "minLength": 1,
          "title": "Normalization",
          "type": "string"
        },
        "officially_defined": {
          "title": "Officially Defined",
          "type": "boolean"
        },
        "pooling": {
          "minLength": 1,
          "title": "Pooling",
          "type": "string"
        },
        "projection": {
          "minLength": 1,
          "title": "Projection",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "selection_rationale": {
          "minLength": 1,
          "title": "Selection Rationale",
          "type": "string"
        },
        "status": {
          "enum": [
            "declared",
            "verified",
            "unsupported"
          ],
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "task_head_relation": {
          "minLength": 1,
          "title": "Task Head Relation",
          "type": "string"
        },
        "temporal_hop_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Hop Seconds"
        }
      },
      "required": [
        "schema_version",
        "embedding_id",
        "name",
        "description",
        "officially_defined",
        "default",
        "network_location",
        "layout",
        "granularity",
        "pooling",
        "projection",
        "normalization",
        "task_head_relation",
        "dtype",
        "status",
        "selection_rationale"
      ],
      "title": "EmbeddingSpec",
      "type": "object"
    },
    "EmbeddingsSection": {
      "additionalProperties": false,
      "description": "Embedding declarations with one selected default.",
      "properties": {
        "default_embedding_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Default Embedding Id",
          "type": "string"
        },
        "items": {
          "contains": {
            "properties": {
              "default": {
                "const": true
              }
            },
            "required": [
              "default"
            ],
            "type": "object"
          },
          "items": {
            "$ref": "#/$defs/EmbeddingSpec"
          },
          "maxContains": 1,
          "minContains": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "default_embedding_id",
        "items"
      ],
      "title": "EmbeddingsSection",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "inferred"
              }
            }
          },
          "then": {
            "properties": {
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "rationale"
            ]
          }
        }
      ],
      "description": "Concise evidence record for a material claim.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "revision": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "symbol": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "status",
        "description"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceStatus": {
      "description": "Evidence provenance status.",
      "enum": [
        "officially_reported",
        "observed",
        "inferred",
        "unresolved",
        "not_reported",
        "not_applicable"
      ],
      "minLength": 1,
      "title": "EvidenceStatus",
      "type": "string"
    },
    "Identity": {
      "additionalProperties": false,
      "description": "Checkpoint-specific card identity.",
      "properties": {
        "checkpoint_name": {
          "minLength": 1,
          "title": "Checkpoint Name",
          "type": "string"
        },
        "framework": {
          "const": "pytorch",
          "minLength": 1,
          "title": "Framework",
          "type": "string"
        },
        "model_family": {
          "minLength": 1,
          "title": "Model Family",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        },
        "wrapper_entry_point": {
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Z][A-Za-z0-9_]*$",
          "title": "Wrapper Entry Point",
          "type": "string"
        }
      },
      "required": [
        "model_name",
        "model_family",
        "variant",
        "checkpoint_name",
        "framework",
        "wrapper_entry_point"
      ],
      "title": "Identity",
      "type": "object"
    },
    "IssueRecord": {
      "additionalProperties": false,
      "description": "Explicit issue record; lifecycle state is not used for every problem.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "issue_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Issue Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/IssueStatus"
        }
      },
      "required": [
        "issue_id",
        "kind",
        "status",
        "description",
        "impact"
      ],
      "title": "IssueRecord",
      "type": "object"
    },
    "IssueStatus": {
      "description": "Issue lifecycle state.",
      "enum": [
        "open",
        "resolved",
        "accepted",
        "not_applicable"
      ],
      "minLength": 1,
      "title": "IssueStatus",
      "type": "string"
    },
    "LicenseRecord": {
      "additionalProperties": false,
      "description": "Informational license metadata; never an automatic blocker.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "status": {
          "enum": [
            "officially_reported",
            "observed",
            "inferred",
            "unresolved",
            "not_reported",
            "not_applicable"
          ],
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "status"
      ],
      "title": "LicenseRecord",
      "type": "object"
    },
    "MetricRecord": {
      "additionalProperties": false,
      "description": "Reported metric record.",
      "properties": {
        "checkpoint_specific": {
          "title": "Checkpoint Specific",
          "type": "boolean"
        },
        "dataset": {
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "protocol": {
          "minLength": 1,
          "title": "Protocol",
          "type": "string"
        },
        "source_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "split": {
          "minLength": 1,
          "title": "Split",
          "type": "string"
        },
        "task": {
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "task",
        "dataset",
        "split",
        "metric",
        "value",
        "protocol",
        "checkpoint_specific",
        "source_status"
      ],
      "title": "MetricRecord",
      "type": "object"
    },
    "ModelCardLifecycle": {
      "description": "Lifecycle states defined by project_spec.md.",
      "enum": [
        "draft",
        "analyzed",
        "environment_resolved",
        "checkpoint_verified",
        "runtime_verified",
        "profiled"
      ],
      "minLength": 1,
      "title": "ModelCardLifecycle",
      "type": "string"
    },
    "OutputComponent": {
      "additionalProperties": false,
      "description": "Stable output component description.",
      "properties": {
        "dimensions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "dtype": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "granularity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Granularity"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "layout": {
          "minLength": 1,
          "title": "Layout",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rank": {
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "semantic_kind": {
          "minLength": 1,
          "title": "Semantic Kind",
          "type": "string"
        },
        "task_head_relation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
